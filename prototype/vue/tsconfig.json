{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "checkJs": false, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "src/**/*.js"]
}
