{
  "openapi": "3.0.3",
  "info": {
    "title": "RBAC0 F 审计模块 API",
    "version": "1.0.0",
    "description": "从V1.2契约提取的四个只读接口。demo使用服务端验证的Basic账号；生产Bearer认证由A/E宿主提供，非demo独立运行默认拒绝访问。独立安全事件仅为内部端口，无公开写入/修改/删除接口。空action等同未筛选；from/to为UTC半开区间，默认近7个上海自然日，最多90日。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "F模块本地演示；仅在demo profile启用Basic"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "demoBasic": []
    }
  ],
  "paths": {
    "/api/v1/platform/audit-logs": {
      "get": {
        "operationId": "operation_035",
        "summary": "分页查询审计日志",
        "tags": [
          "F-审计查询"
        ],
        "x-stage": "RBAC0",
        "x-permission": "PLATFORM_ADMIN",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "actorId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "example": "102",
              "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。"
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            }
          },
          {
            "name": "sysId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "example": "102",
              "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，JSON中的ID保持字符串。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuditPage"
                    },
                    "requestId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "data",
                    "requestId"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求格式错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未认证或会话无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "权限或上下文不符",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "当前范围不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "字段不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "安全依赖不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "仅启用的平台管理员的平台会话；sysId为空。"
      }
    },
    "/api/v1/platform/audit-logs/{logId}": {
      "get": {
        "operationId": "operation_036",
        "summary": "读取审计详情",
        "tags": [
          "F-审计查询"
        ],
        "x-stage": "RBAC0",
        "x-permission": "PLATFORM_ADMIN",
        "parameters": [
          {
            "name": "logId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "example": "102",
              "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，JSON中的ID保持字符串。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuditView"
                    },
                    "requestId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "data",
                    "requestId"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求格式错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未认证或会话无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "权限或上下文不符",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "当前范围不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "字段不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "安全依赖不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "仅启用的平台管理员的平台会话；sysId为空。"
      }
    },
    "/api/v1/systems/{sysId}/audit-logs": {
      "get": {
        "operationId": "operation_037",
        "summary": "分页查询审计日志",
        "tags": [
          "F-审计查询"
        ],
        "x-stage": "RBAC0",
        "x-permission": "sys:audit:read",
