            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "example": "102",
              "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "actorId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "example": "102",
              "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。"
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，JSON中的ID保持字符串。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuditPage"
                    },
                    "requestId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "data",
                    "requestId"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求格式错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未认证或会话无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "权限或上下文不符",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "当前范围不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "字段不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "安全依赖不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "路径sysId必须等于会话sysId，随后执行操作权限和对象范围校验。"
      }
    },
    "/api/v1/systems/{sysId}/audit-logs/{logId}": {
      "get": {
        "operationId": "operation_038",
        "summary": "读取审计详情",
        "tags": [
          "F-审计查询"
        ],
        "x-stage": "RBAC0",
        "x-permission": "sys:audit:read",
        "parameters": [
          {
            "name": "sysId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "example": "102",
              "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。"
            }
          },
          {
            "name": "logId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "example": "102",
              "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，JSON中的ID保持字符串。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuditView"
                    },
                    "requestId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "data",
                    "requestId"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求格式错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未认证或会话无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "权限或上下文不符",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "当前范围不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "字段不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "安全依赖不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "路径sysId必须等于会话sysId，随后执行操作权限和对象范围校验。"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "demoBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "仅demo；DemoOnly12345可通过AUDIT_DEMO_PASSWORD覆盖"
      }
    },
    "schemas": {
      "AuditPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditView"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "AuditView": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "example": "102",
            "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。"
          },
          "sysId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "example": "102",
            "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。",
            "nullable": true
          },
          "actorId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "example": "102",
            "description": "正的有符号BIGINT十进制字符串，最大9223372036854775807，服务端校验范围。",
            "nullable": true
          },
          "actorName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "targetType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "before": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "after": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "ip": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45
          }
        },
        "required": [
          "id",
          "sysId",
          "actorId",
          "actorName",
          "action",
          "targetType",
          "targetId",
          "before",
          "after",
          "requestId",
          "createdAt"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      }
    }
  }
}
